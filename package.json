{
  "name": "allex-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir .ssr && node scripts/generate-pages.mjs",
    "build:netlify": "node scripts/build-target.mjs netlify",
    "build:official": "node scripts/build-target.mjs official",
    "prepare:release": "node scripts/prepare-release.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "nodemailer": "^10.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "vite": "^7.1.0"
  }
}
